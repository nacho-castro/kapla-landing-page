---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Navbar from '../components/Navbar.astro';
import { site, socialLinks } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

// Absolute URLs come from `site` in astro.config.mjs.
const { title = site.name, description = site.description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = site.ogImage ? new URL(site.ogImage, Astro.site).href : null;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: Astro.site?.href,
  description: site.description,
  ...(site.email ? { email: site.email } : {}),
  sameAs: socialLinks.flatMap((social) => (social.href ? [social.href] : [])),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={site.ogImageAlt} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#00072d" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body class="bg-white text-ink antialiased">
    <a
      href="#contenido"
      class="sr-only rounded-md bg-brand px-4 py-2 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60]"
    >
      Saltar al contenido
    </a>
    <Navbar />
    <main id="contenido" class="outline-none" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
