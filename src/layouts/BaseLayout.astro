---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Navbar from '../components/Navbar.astro';
import { getContent, languages, pagePath, type PageName } from '../data/content';
import { site, socialLinks } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Which page this is, so the language switch and hreflang point to its twin in the other language. */
  page?: PageName;
}

// Absolute URLs come from `site` in astro.config.mjs.
const c = getContent(Astro.currentLocale);
const { title = c.meta.title, description = c.meta.description, page = 'home' } = Astro.props;
const lang = c.lang;
const alternates = { es: pagePath('es', page), en: pagePath('en', page) };
const alternateUrls = { es: new URL(alternates.es, Astro.site).href, en: new URL(alternates.en, Astro.site).href };
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = site.ogImage ? new URL(site.ogImage, Astro.site).href : null;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: Astro.site?.href,
  description: c.meta.description,
  ...(site.email ? { email: site.email } : {}),
  sameAs: socialLinks.flatMap((social) => (social.href ? [social.href] : [])),
};
---

<!doctype html>
<html lang={languages[lang].htmlLang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.className = 'js';</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={alternateUrls.es} />
    <link rel="alternate" hreflang="en" href={alternateUrls.en} />
    <link rel="alternate" hreflang="x-default" href={alternateUrls.es} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    <meta property="og:locale:alternate" content={languages[lang === 'es' ? 'en' : 'es'].ogLocale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={c.meta.ogImageAlt} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#00072d" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body class="bg-white text-ink antialiased">
    <a
      href="#contenido"
      class="sr-only rounded-md bg-brand px-4 py-2 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60]"
    >
      {c.ui.skip}
    </a>
    <Navbar alternates={alternates} />
    <main id="contenido" class="outline-none" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <script>
      // Scroll reveal: elements marked data-reveal fade up once when they enter the viewport.
      const items = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const showAll = () => items.forEach((item) => item.classList.add('is-visible'));
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        showAll();
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) continue;
              const el = entry.target;
              const siblings = Array.from(el.parentElement?.children ?? []).filter((c) => c.hasAttribute('data-reveal'));
              // Stagger siblings that appear together; clear the delay afterwards so hover stays instant.
              el.style.transitionDelay = `${Math.min(siblings.indexOf(el), 5) * 90}ms`;
              el.classList.add('is-visible');
              setTimeout(() => (el.style.transitionDelay = ''), 1200);
              observer.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
