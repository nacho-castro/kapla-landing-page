---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { sections, featuredCase, otherCases } from '../data/site';

const { id, title } = sections.work;
const c = featuredCase;
---

<Section id={id} tone="dark" labelledBy={`${id}-title`}>
  <h2 id={`${id}-title`} class="text-3xl font-bold tracking-tight md:text-4xl">{title}</h2>

  <article class="mt-10 grid gap-8 md:grid-cols-2 md:items-center">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h3 class="text-2xl font-bold">{c.name}</h3>
        {c.status && (
          <span class="rounded-full border border-accent-light px-3 py-0.5 text-xs font-semibold text-accent-light">
            {c.status}
          </span>
        )}
      </div>
      <p class="mt-3 text-lg font-semibold">{c.tagline}</p>
      {c.description && <p class="mt-2 text-muted-dark">{c.description}</p>}
      <ul class="mt-5 space-y-2 text-muted-dark">
        {c.features.map((f) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-accent-light">-</span>
            {f}
          </li>
        ))}
      </ul>
      {c.link && (
        <a
          href={c.link.href}
          class="mt-6 inline-block font-semibold text-accent-light underline underline-offset-4"
          {...(c.link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {c.link.label}
          {c.link.external && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
        </a>
      )}
    </div>
    {c.image && c.link && (
      <a
        href={c.link.href}
        class="mx-auto block w-64 max-w-full md:w-72"
        {...(c.link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <Image src={c.image.src} alt={c.image.alt} widths={[256, 512]} sizes="288px" class="h-auto w-full" />
        <span class="sr-only">
          Abrir {c.name}{c.link.external && ' (se abre en una pestaña nueva)'}
        </span>
      </a>
    )}
  </article>

  {otherCases.length > 0 && (
    <ul class="mt-14 space-y-6">
      {otherCases.map((o) => (
        <li class="grid gap-6 rounded-lg border border-white/15 p-6 md:grid-cols-2 md:items-center">
          <div>
            <h3 class="text-xl font-bold">{o.name}</h3>
            <p class="mt-2 text-muted-dark">{o.tagline}</p>
            {o.link && (
              <a
                href={o.link.href}
                class="mt-4 inline-block font-semibold text-accent-light underline underline-offset-4"
                {...(o.link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {o.link.label}
                {o.link.external && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
              </a>
            )}
          </div>
          {o.image && o.link && (
            <a
              href={o.link.href}
              class="block overflow-hidden rounded-md"
              {...(o.link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <Image src={o.image.src} alt={o.image.alt} widths={[480, 960]} sizes="(min-width: 1024px) 480px, (min-width: 768px) 40vw, 100vw" class="h-auto w-full" />
              <span class="sr-only">
                Abrir {o.name}{o.link.external && ' (se abre en una pestaña nueva)'}
              </span>
            </a>
          )}
        </li>
      ))}
    </ul>
  )}
</Section>
