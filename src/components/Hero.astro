---
import HeroBackground from './HeroBackground.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import { getContent } from '../data/content';
import { externalAttrs } from '../utils/links';

const c = getContent(Astro.currentLocale);
const { title, subtitle, support, titleLead, titleWords: words, highlight, primary, secondary } = c.hero;
const id = 'inicio';
// The highlighted word of the subtitle breathes (grows and shrinks slightly).
const [subtitleBefore = '', subtitleAfter = ''] = subtitle.split(highlight);
---

<Section id={id} tone="dark" labelledBy={`${id}-title`} class="flex min-h-svh items-center pt-28! pb-16! md:pt-32! md:pb-20! [&>div]:w-full">
  <HeroBackground slot="background" />
  <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
  <h1 id={`${id}-title`} class="hero-in text-4xl font-semibold tracking-tight text-white md:text-6xl lg:text-7xl">
    {/* Screen readers and no-motion visitors get the plain title; the rotating words are decoration. */}
    <span class="sr-only">{title}</span>
    <span aria-hidden="true">
      <span class="block">{titleLead}</span>
      <span class="rotator">
        {words.map((word) => <span class="rotator-word">{word}.</span>)}
      </span>
    </span>
  </h1>
  <p class="hero-in hero-in-2 mt-5 max-w-2xl text-2xl font-medium text-accent-light md:text-3xl">
    {subtitleBefore}<span class="pulse-word">{highlight}</span>{subtitleAfter}
  </p>
  <p class="hero-in hero-in-3 mt-6 max-w-xl text-lg text-muted-dark">{support}</p>
  <div class="hero-in hero-in-4 mt-10 flex w-full flex-col items-stretch justify-center gap-3 sm:w-auto sm:flex-row">
    <a
      href={primary.href}
      {...externalAttrs(primary, c.ui.newTab)}
      class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/25 bg-violet px-6 font-semibold text-white hover:bg-violet-deep"
    >
      <Icon name="whatsapp" class="size-5" />
      {primary.label}
    </a>
    <a
      href={secondary.href}
      class="inline-flex min-h-12 items-center justify-center rounded-full border border-soft/40 px-6 font-semibold text-soft hover:bg-white/10"
    >
      {secondary.label}
    </a>
  </div>
  </div>
</Section>
