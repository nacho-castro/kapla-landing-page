---
import Section from './Section.astro';
import { heroCtas, sections } from '../data/site';
import { externalAttrs } from '../utils/links';

const { id, title, subtitle } = sections.hero;
const { primary, secondary } = heroCtas;
---

<Section id={id} tone="light" labelledBy={`${id}-title`}>
  <h1 id={`${id}-title`} class="max-w-4xl text-4xl font-bold tracking-tight text-balance text-brand md:text-5xl lg:text-6xl">
    {title}
  </h1>
  {subtitle && <p class="mt-6 max-w-2xl text-xl text-muted md:text-2xl">{subtitle}</p>}
  <div class="mt-8 flex flex-col gap-3 sm:flex-row">
    <a
      href={primary.href}
      {...externalAttrs(primary)}
      class="inline-flex min-h-12 items-center justify-center rounded-md bg-brand px-6 font-semibold text-white hover:bg-ink"
    >
      {primary.label}
    </a>
    <a
      href={secondary.href}
      class="inline-flex min-h-12 items-center justify-center rounded-md border border-brand px-6 font-semibold text-brand hover:bg-surface"
    >
      {secondary.label}
    </a>
  </div>
</Section>
