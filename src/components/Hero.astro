---
import HeroBackground from './HeroBackground.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import { heroCtas, sections } from '../data/site';
import { externalAttrs } from '../utils/links';

const { id, title, subtitle, support, titleLead, titleWords } = sections.hero;
const words: string[] = titleWords;
// The highlighted word of the subtitle breathes (grows and shrinks slightly).
const highlight = 'ordenado';
const [subtitleBefore = '', subtitleAfter = ''] = subtitle.split(highlight);
const { primary, secondary } = heroCtas;
---

<Section id={id} tone="dark" labelledBy={`${id}-title`} class="bg-linear-to-b from-ink to-navy pt-36! pb-20! md:pt-44! md:pb-28!">
  <HeroBackground slot="background" />
  <h1 id={`${id}-title`} class="hero-in max-w-4xl text-4xl font-semibold tracking-tight text-white md:text-6xl lg:text-7xl">
    {/* Screen readers and no-motion visitors get the plain title; the rotating words are decoration. */}
    <span class="sr-only">{title}</span>
    <span aria-hidden="true">
      {titleLead}{" "}
      <span class="rotator">
        {words.map((word) => <span class="rotator-word">{word}.</span>)}
      </span>
    </span>
  </h1>
  <p class="hero-in hero-in-2 mt-4 max-w-2xl text-2xl font-medium text-accent-light md:text-3xl">
    {subtitleBefore}<span class="pulse-word">{highlight}</span>{subtitleAfter}
  </p>
  <p class="hero-in hero-in-3 mt-6 max-w-xl text-lg text-muted-dark">{support}</p>
  <div class="hero-in hero-in-4 mt-10 flex flex-col gap-3 sm:flex-row">
    <a
      href={primary.href}
      {...externalAttrs(primary)}
      class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-whatsapp px-6 font-semibold text-ink hover:brightness-95"
    >
      <Icon name="whatsapp" class="size-5" />
      {primary.label}
    </a>
    <a
      href={secondary.href}
      class="inline-flex min-h-12 items-center justify-center rounded-full border border-soft/40 px-6 font-semibold text-soft hover:bg-white/10"
    >
      {secondary.label}
    </a>
  </div>
</Section>
