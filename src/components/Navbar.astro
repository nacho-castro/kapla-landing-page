---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { navCta, navLinks, sections, site } from '../data/site';
import { externalAttrs } from '../utils/links';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-white">
  <nav
    aria-label="Principal"
    class="mx-auto flex h-nav max-w-content items-center justify-between px-gutter"
  >
    <a href={`/#${sections.hero.id}`} class="text-brand" aria-label={`${site.name}, ir al inicio`}>
      <Logo />
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <ul class="flex items-center gap-8">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm font-medium text-ink hover:text-brand">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={navCta.href}
        {...externalAttrs(navCta)}
        class="rounded-md bg-brand px-4 py-2 text-sm font-semibold text-white hover:bg-ink"
      >
        {navCta.label}
      </a>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="group -mr-2 inline-flex size-11 items-center justify-center rounded-md text-ink md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menú"
    >
      <Icon name="menu" class="size-6 group-aria-expanded:hidden" />
      <Icon name="close" class="hidden size-6 group-aria-expanded:block" />
    </button>
  </nav>

  <div id="mobile-menu" class="border-t border-line bg-white md:hidden" hidden>
    <ul class="mx-auto flex max-w-content flex-col px-gutter py-4">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="block py-3 text-base font-medium text-ink hover:text-brand">
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-3">
        <a
          href={navCta.href}
        {...externalAttrs(navCta)}
          class="block rounded-md bg-brand px-4 py-3 text-center text-base font-semibold text-white"
        >
          {navCta.label}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
