---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { navCta, navLinks, sections, site } from '../data/site';
import { externalAttrs } from '../utils/links';
---

<header class="nav-drop fixed inset-x-0 top-3 z-50 px-3 md:top-4 md:px-gutter" data-tone="dark">
  <nav
    aria-label="Principal"
    class="mx-auto max-w-content md:grid md:grid-cols-[1fr_auto_1fr] md:items-center md:gap-4"
  >
    <div class="nav-pill flex h-14 items-center justify-between rounded-full pr-1.5 pl-5 md:contents">
      <a
        href={`/#${sections.hero.id}`}
        class="text-white md:nav-pill md:inline-flex md:h-12 md:items-center md:justify-self-start md:rounded-full md:px-5"
        aria-label={`${site.name}, ir al inicio`}
      >
        <Logo class="h-9 md:h-9" />
      </a>

      <ul
        id="nav-links"
        class="relative hidden items-center gap-1 rounded-full p-1 md:nav-pill md:flex"
      >
        <li id="nav-indicator" aria-hidden="true" class="absolute top-1 left-0 h-[calc(100%-0.5rem)] w-0 rounded-full bg-soft opacity-0 transition-[transform,width,opacity] duration-300 ease-out motion-reduce:transition-none"></li>
        {
          navLinks.map((link) => (
            <li class="relative">
              <a
                href={link.href}
                data-also={link.also?.join(' ')}
                class="inline-flex min-h-10 items-center rounded-full px-4 text-sm font-medium text-soft transition-colors hover:text-white aria-[current=true]:text-ink motion-reduce:transition-none"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={navCta.href}
        {...externalAttrs(navCta)}
        class="hidden min-h-12 items-center rounded-full border border-white/25 bg-violet px-5 text-sm font-semibold text-white hover:bg-violet-deep md:inline-flex md:justify-self-end"
      >
        {navCta.label}
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="group inline-flex size-11 items-center justify-center rounded-full text-white md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir o cerrar el menú"
      >
        <Icon name="menu" class="size-6 group-aria-expanded:hidden" />
        <Icon name="close" class="hidden size-6 group-aria-expanded:block" />
      </button>
    </div>

    <div id="mobile-menu" class="nav-pill mt-2 rounded-3xl p-3 md:hidden" hidden>
      <ul class="flex flex-col gap-1">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-also={link.also?.join(' ')}
                class="flex min-h-11 items-center rounded-full px-4 text-base font-medium text-soft hover:text-white aria-[current=true]:bg-soft aria-[current=true]:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="pt-2">
          <a
            href={navCta.href}
            {...externalAttrs(navCta)}
            class="flex min-h-12 items-center justify-center rounded-full border border-white/25 bg-violet px-4 text-base font-semibold text-white hover:bg-violet-deep"
          >
            {navCta.label}
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Active section: highlight the matching link (desktop pill slides between links).
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('header nav a[href^="/#"]'));
  const indicator = document.getElementById('nav-indicator');
  const idOf = (link: HTMLAnchorElement) => link.getAttribute('href')?.slice(2) ?? '';
  // Section id -> id of the link to highlight (a link can also cover other sections via data-also).
  const owner = new Map<string, string>();
  for (const link of links) {
    owner.set(idOf(link), idOf(link));
    for (const extra of (link.dataset['also'] ?? '').split(' ').filter(Boolean)) owner.set(extra, idOf(link));
  }
  let currentId: string | null = null;

  const moveIndicator = () => {
    if (!indicator) return;
    const active = links.find(
      (link) => link.getAttribute('aria-current') === 'true' && link.offsetParent !== null && link.closest('#nav-links'),
    );
    if (!active) {
      indicator.style.opacity = '0';
      return;
    }
    const item = active.parentElement as HTMLElement;
    indicator.style.width = `${item.offsetWidth}px`;
    indicator.style.transform = `translateX(${item.offsetLeft}px)`;
    indicator.style.opacity = '1';
  };

  const setActive = (id: string | null) => {
    if (id === currentId) return;
    currentId = id;
    for (const link of links) {
      if (id !== null && idOf(link) === id) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
    moveIndicator();
  };

  if (links.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(owner.get(entry.target.id) ?? null);
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    document.querySelectorAll('main section[id]').forEach((section) => observer.observe(section));
    window.addEventListener('resize', moveIndicator);
    document.fonts?.ready.then(moveIndicator);
  }
</script>
