---
// KAPLA logo (white version, for the dark navbar and footer). Size it with a height class, e.g. "h-8".
import { Image } from 'astro:assets';
import logo from '../assets/kapla-logo-white.png';

interface Props {
  class?: string;
}

const { class: className = 'h-8' } = Astro.props;
---

<Image
  src={logo}
  alt=""
  widths={[160, 320, 480]}
  sizes="160px"
  loading="eager"
  class:list={['w-auto', className]}
/>
