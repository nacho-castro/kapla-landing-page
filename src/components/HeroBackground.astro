---
import Glow from './Glow.astro';

// Decorative hero background: moving glows, a faded dot grid and a small "automation network".
// The network flies into place on load and its nodes are pulled toward the pointer (see the script).
// Static when the visitor prefers reduced motion.
const nodes = [
  { x: 70, y: 70 },
  { x: 210, y: 40 },
  { x: 350, y: 100 },
  { x: 110, y: 200 },
  { x: 330, y: 360, hub: true },
  { x: 410, y: 240 },
  { x: 190, y: 340 },
  { x: 250, y: 220 },
  { x: 60, y: 320 },
];
const edges: [number, number][] = [
  [0, 1], [1, 2], [0, 3], [1, 4], [2, 4], [2, 5], [3, 4],
  [4, 5], [3, 8], [4, 6], [6, 7], [5, 7], [8, 6], [3, 6],
];
// Full class strings so Tailwind can see them.
const delays = ['', '[animation-delay:1s]', '[animation-delay:2s]', '[animation-delay:3s]', '', '[animation-delay:1.5s]', '[animation-delay:2.5s]', '[animation-delay:0.5s]', '[animation-delay:3.5s]'];
const line = (a: number, b: number) => {
  const p = nodes[a];
  const q = nodes[b];
  return p && q ? `M${p.x} ${p.y}L${q.x} ${q.y}` : '';
};
---

<Glow variant="a" />
<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
  <div class="dot-grid absolute inset-0"></div>
  <div class="absolute top-1/2 left-1/2 w-[34rem] max-w-none -translate-x-1/2 -translate-y-1/2 opacity-45 sm:w-[46rem] lg:w-[62rem]">
    <svg data-graph class="net-float h-auto w-full" viewBox="0 0 480 420" fill="none" focusable="false">
      <g>
        {edges.map(([a, b], i) => <path data-edge={`${a}-${b}`} class:list={['net-line', i % 2 === 1 && 'net-line-r']} d={line(a, b)} />)}
      </g>
      <g>
        {
          nodes.map((n, i) => (
            <g data-node={`${n.x},${n.y}`} transform={`translate(${n.x} ${n.y})`}>
              {n.hub ? (
                <>
                  <circle class="net-pulse" r="16" />
                  <circle class="net-pulse [animation-delay:1.7s]" r="16" />
                  <circle class="net-hub" r="16" />
                </>
              ) : (
                <circle class:list={['net-node', delays[i]]} r="8" />
              )}
            </g>
          ))
        }
      </g>
    </svg>
  </div>
</div>

<script>
  const svg = document.querySelector<SVGSVGElement>('[data-graph]');
  const hero = svg?.closest('section');
  if (svg && hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    type Node = { el: SVGGElement; hx: number; hy: number; x: number; y: number; vx: number; vy: number };
    const nodes: Node[] = Array.from(svg.querySelectorAll<SVGGElement>('[data-node]')).map((el) => {
      const [hx = 0, hy = 0] = (el.dataset['node'] ?? '').split(',').map(Number);
      // Start scattered so the network "assembles" itself on load.
      return { el, hx, hy, x: hx + (Math.random() - 0.5) * 320, y: hy + (Math.random() - 0.5) * 320, vx: 0, vy: 0 };
    });
    const edges = Array.from(svg.querySelectorAll<SVGPathElement>('[data-edge]')).map((el) => {
      const [a = 0, b = 0] = (el.dataset['edge'] ?? '').split('-').map(Number);
      return { el, a, b };
    });

    const RADIUS = 160;
    const MAX_OFFSET = 70;
    let pointer: { x: number; y: number } | null = null;
    let frame = 0;

    const draw = () => {
      for (const n of nodes) n.el.setAttribute('transform', `translate(${n.x.toFixed(1)} ${n.y.toFixed(1)})`);
      for (const e of edges) {
        const p = nodes[e.a];
        const q = nodes[e.b];
        if (p && q) e.el.setAttribute('d', `M${p.x.toFixed(1)} ${p.y.toFixed(1)}L${q.x.toFixed(1)} ${q.y.toFixed(1)}`);
      }
    };

    const tick = () => {
      let moving = false;
      for (const n of nodes) {
        // Spring back to the home position...
        let fx = (n.hx - n.x) * 0.04;
        let fy = (n.hy - n.y) * 0.04;
        // ...and get pulled toward the pointer when it is close.
        if (pointer) {
          const dx = pointer.x - n.x;
          const dy = pointer.y - n.y;
          const dist = Math.hypot(dx, dy);
          if (dist < RADIUS && dist > 0.001) {
            const pull = (1 - dist / RADIUS) * 0.09;
            fx += dx * pull;
            fy += dy * pull;
          }
        }
        n.vx = (n.vx + fx) * 0.82;
        n.vy = (n.vy + fy) * 0.82;
        n.x += n.vx;
        n.y += n.vy;
        const ox = n.x - n.hx;
        const oy = n.y - n.hy;
        const off = Math.hypot(ox, oy);
        if (off > MAX_OFFSET && pointer) {
          n.x = n.hx + (ox / off) * MAX_OFFSET;
          n.y = n.hy + (oy / off) * MAX_OFFSET;
        }
        if (Math.abs(n.vx) > 0.02 || Math.abs(n.vy) > 0.02 || off > 0.1) moving = true;
      }
      draw();
      frame = moving || pointer ? requestAnimationFrame(tick) : 0;
    };
    const start = () => {
      if (!frame) frame = requestAnimationFrame(tick);
    };

    const track = (event: PointerEvent) => {
      const rect = svg.getBoundingClientRect();
      pointer = {
        x: ((event.clientX - rect.left) / rect.width) * 480,
        y: ((event.clientY - rect.top) / rect.height) * 420,
      };
      start();
    };
    hero.addEventListener('pointermove', track);
    hero.addEventListener('pointerdown', track);
    for (const type of ['pointerleave', 'pointerup', 'pointercancel']) {
      hero.addEventListener(type, () => {
        pointer = null;
        start();
      });
    }

    draw();
    start();
  }
</script>
