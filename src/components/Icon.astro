---
// Inline SVG icons with a uniform 24px grid and stroke style. Decorative by default.
import type { ProcessIcon } from '../data/site';

export type IconName = 'menu' | 'close' | 'instagram' | 'linkedin' | 'tiktok' | ProcessIcon;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-6' } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {
    name === 'instagram' && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="4" />
        <circle cx="12" cy="12" r="3.5" />
        <path d="M16.5 7.5v.01" />
      </>
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="4" />
        <path d="M8 11v5M8 8v.01M12 16v-5M16 16v-3a2 2 0 0 0-4 0" />
      </>
    )
  }
  {
    name === 'tiktok' && (
      <path d="M21 7.9v4a10 10 0 0 1-5-2v4.6a6.5 6.5 0 1 1-8-6.3v4.3a2.5 2.5 0 1 0 4 2V3h4.1A6 6 0 0 0 21 7.9z" />
    )
  }
  {
    name === 'audit' && (
      <>
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.3-4.3M8 11h6M11 8v6" />
      </>
    )
  }
  {
    name === 'design' && (
      <>
        <path d="M4 20l4-1L19 8a2.1 2.1 0 0 0-3-3L5 16l-1 4z" />
        <path d="M14 7l3 3M13 20h7" />
      </>
    )
  }
  {
    name === 'build' && (
      <>
        <rect x="3" y="4" width="18" height="12" rx="2" />
        <path d="M8 20h8M12 16v4M9 9l-2 1.5L9 12M15 9l2 1.5-2 1.5" />
      </>
    )
  }
  {
    name === 'training' && (
      <>
        <path d="M22 9L12 4 2 9l10 5 10-5z" />
        <path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5M22 9v6" />
      </>
    )
  }
  {
    name === 'optimize' && (
      <>
        <path d="M3 17l6-6 4 4 8-8" />
        <path d="M15 7h6v6" />
      </>
    )
  }
</svg>
