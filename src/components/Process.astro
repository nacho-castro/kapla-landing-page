---
import Glow from './Glow.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import { getContent } from '../data/content';

const c = getContent(Astro.currentLocale);
const { id, title } = c.sections.process;
---

<Section id={id} tone="dark" labelledBy={`${id}-title`}>
  <Glow slot="background" variant="b" />
  <div data-reveal>
    <h2 id={`${id}-title`} class="text-3xl font-semibold tracking-tight md:text-4xl">{title}</h2>
    <p class="mt-4 max-w-2xl text-lg text-muted-dark">
      {c.process.intro}
    </p>
  </div>
  <ol class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      c.process.steps.map((step, index) => (
        <li data-reveal class="border-t border-line-dark pt-6">
          <div class="flex items-center gap-3 text-accent-light">
            <Icon name={step.icon} />
            <span class="text-sm font-semibold tabular-nums">
              {String(index + 1).padStart(2, '0')}
            </span>
          </div>
          <h3 class="mt-4 text-lg font-semibold">{step.title}</h3>
          <p class="mt-2 text-muted-dark">{step.text}</p>
        </li>
      ))
    }
  </ol>
</Section>
