---
import Icon from './Icon.astro';
import Glow from './Glow.astro';
import Section from './Section.astro';
import TodoContent from './TodoContent.astro';
import { heroCtas, sections, services } from '../data/site';
import { externalAttrs } from '../utils/links';

const { id, title, subtitle } = sections.services;
const cta = heroCtas.primary;
---

<Section id={id} tone="dark" labelledBy={`${id}-title`}>
  <Glow slot="background" variant="a" />
  <div data-reveal>
    <h2 id={`${id}-title`} class="text-3xl font-semibold tracking-tight md:text-4xl">{title}</h2>
    <p class="mt-4 max-w-2xl text-lg text-muted-dark">{subtitle}</p>
  </div>
  <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      services.map((service) => (
        <li data-reveal class="group rounded-2xl bg-white/5 p-6 ring-1 ring-white/10 transition duration-300 hover:-translate-y-1 hover:bg-white/10 hover:shadow-xl hover:shadow-black/30">
          <span class="inline-flex size-12 items-center justify-center rounded-xl bg-white/10 text-accent-light transition-colors duration-300 group-hover:bg-accent group-hover:text-white">
            <Icon name={service.icon} />
          </span>
          <h3 class="mt-5 text-lg font-semibold">{service.title}</h3>
          <p class="mt-2 text-muted-dark">{service.text}</p>
          {service.todo && (
            <div class="mt-3">
              {/* TODO-CONTENIDO: exact scope of social media management. */}
              <TodoContent tone="dark">{service.todo}</TodoContent>
            </div>
          )}
        </li>
      ))
    }
  </ul>
  <div data-reveal class="mt-10">
    <a
      href={cta.href}
      {...externalAttrs(cta)}
      class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-whatsapp px-6 font-semibold text-ink hover:brightness-95"
    >
      <Icon name="whatsapp" class="size-5" />
      {cta.label}
    </a>
  </div>
</Section>
