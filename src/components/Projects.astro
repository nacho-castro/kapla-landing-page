---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import TodoContent from './TodoContent.astro';
import { projects, sections, type ProjectShot } from '../data/site';

const { id, title, subtitle } = sections.projects;

const widths = [480, 768, 1152];
const sizes = '(min-width: 1024px) 720px, (min-width: 768px) 90vw, 100vw';

type Shot = { kind: 'desktop' | 'mobile'; shot: ProjectShot };
---

<Section id={id} tone="dark" labelledBy={`${id}-title`}>
  <h2 id={`${id}-title`} class="text-3xl font-semibold tracking-tight md:text-4xl">{title}</h2>
  <p class="mt-4 max-w-2xl text-lg text-muted-dark">{subtitle}</p>

  <div data-projects class="mt-10">
    {/* Tabs are shown only with JavaScript; without it every project is listed one after another. */}
    <div data-tablist-wrap hidden>
      <div role="tablist" aria-label="Proyectos" class="flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none]">
        {
          projects.map((p, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${p.id}`}
              aria-controls={`panel-${p.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="flex min-h-14 shrink-0 flex-col items-start justify-center rounded-2xl border border-white/15 px-5 py-2 text-left text-soft hover:border-white/40 aria-selected:border-soft aria-selected:bg-soft aria-selected:text-ink"
            >
              <span class="font-semibold">{p.name}</span>
              <span class="text-sm opacity-80">{p.sector}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-6 space-y-16">
      {
        projects.map((p) => {
          const shots = [
            p.desktop ? { kind: 'desktop', shot: p.desktop } : null,
            p.mobile ? { kind: 'mobile', shot: p.mobile } : null,
          ].filter((x): x is Shot => x !== null);
          return (
            <div
              role="tabpanel"
              id={`panel-${p.id}`}
              aria-labelledby={`tab-${p.id}`}
              data-panel
              class="grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start"
            >
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <h3 class="text-2xl font-semibold">{p.name}</h3>
                  {p.status && (
                    <span class="rounded-full border border-accent-light px-3 py-0.5 text-xs font-semibold text-accent-light">
                      {p.status}
                    </span>
                  )}
                </div>
                <p class="mt-1 text-muted-dark">{p.sector}</p>
                <p class="mt-4 text-lg">{p.description}</p>
                {p.features.length > 0 && (
                  <ul class="mt-4 space-y-2 text-muted-dark">
                    {p.features.map((f) => (
                      <li class="flex gap-2">
                        <span aria-hidden="true" class="text-accent-light">-</span>
                        {f}
                      </li>
                    ))}
                  </ul>
                )}
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full border border-soft/40 px-6 font-semibold text-soft hover:bg-white/10"
                >
                  Ver en vivo
                  <span class="sr-only"> {p.name} (se abre en una pestaña nueva)</span>
                </a>
              </div>

              <div>
                {shots.length === 2 && (
                  <div data-device-toggle hidden class="mb-3 inline-flex rounded-full border border-white/15 p-1">
                    {(['desktop', 'mobile'] as const).map((kind) => (
                      <button
                        type="button"
                        data-device={kind}
                        aria-pressed={kind === 'desktop' ? 'true' : 'false'}
                        class="min-h-10 rounded-full px-4 text-sm font-medium text-soft aria-pressed:bg-soft aria-pressed:text-ink"
                      >
                        {kind === 'desktop' ? 'Computadora' : 'Celular'}
                      </button>
                    ))}
                  </div>
                )}
                <div class="space-y-6">
                  {shots.length === 0 && <TodoContent tone="dark">Captura de página completa de {p.name}.</TodoContent>}
                  {shots.map(({ kind, shot }) => (
                    <figure data-device-view={kind} class:list={[kind === 'mobile' && 'mx-auto max-w-sm']}>
                      <div class="overflow-hidden rounded-xl border border-white/15 bg-navy shadow-lg">
                        <div class="flex h-10 items-center gap-3 border-b border-white/10 bg-blue-deep/50 px-4">
                          <span aria-hidden="true" class="flex gap-1.5">
                            <span class="size-2.5 rounded-full bg-white/25" />
                            <span class="size-2.5 rounded-full bg-white/25" />
                            <span class="size-2.5 rounded-full bg-white/25" />
                          </span>
                          <span class="min-w-0 flex-1 truncate rounded-full bg-ink/60 px-3 py-0.5 text-center text-xs text-muted-dark">
                            {p.domain}
                          </span>
                        </div>
                        <div
                          role="region"
                          tabindex="0"
                          aria-label={`Captura de la página de ${p.name}. Usá el dedo, el mouse o las flechas para recorrerla.`}
                          class="h-[26rem] overflow-y-auto bg-white md:h-[34rem]"
                        >
                          <Image src={shot.src} alt={shot.alt} widths={widths} sizes={sizes} class="block h-auto w-full" />
                        </div>
                      </div>
                      <figcaption class="mt-2 text-sm text-muted-dark">
                        Deslizá dentro del marco para ver la página completa.
                      </figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-projects]').forEach((root) => {
    const wrap = root.querySelector<HTMLElement>('[data-tablist-wrap]');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    if (!wrap || tabs.length === 0) return;
    wrap.hidden = false;

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        const panel = panels[i];
        if (panel) panel.hidden = i !== index;
      });
      if (focus) tabs[index]?.focus();
    };
    select(0);

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === 'ArrowRight' ? (i === last ? 0 : i + 1)
          : event.key === 'ArrowLeft' ? (i === 0 ? last : i - 1)
          : event.key === 'Home' ? 0
          : event.key === 'End' ? last
          : -1;
        if (next === -1) return;
        event.preventDefault();
        select(next, true);
      });
    });

    // Computer / phone toggle: only present when a project has both screenshots.
    panels.forEach((panel) => {
      const toggle = panel.querySelector<HTMLElement>('[data-device-toggle]');
      if (!toggle) return;
      toggle.hidden = false;
      const buttons = Array.from(toggle.querySelectorAll<HTMLButtonElement>('[data-device]'));
      const views = Array.from(panel.querySelectorAll<HTMLElement>('[data-device-view]'));
      const show = (kind: string) => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.device === kind)));
        views.forEach((v) => (v.hidden = v.dataset.deviceView !== kind));
      };
      buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.device ?? 'desktop')));
      show('desktop');
    });
  });
</script>
