---
import Icon from './Icon.astro';
import Glow from './Glow.astro';
import Section from './Section.astro';
import { getContent } from '../data/content';
import { externalAttrs } from '../utils/links';

const c = getContent(Astro.currentLocale);
const { id, title } = c.sections.why;
const { why } = c;
---

<Section id={id} tone="dark" labelledBy={`${id}-title`}>
  <Glow slot="background" variant="b" />
  <div class="grid gap-10 md:grid-cols-[1fr_2fr] md:gap-16">
    <div data-reveal>
      <h2 id={`${id}-title`} class="text-3xl font-semibold tracking-tight md:text-4xl">{title}</h2>
      <p class="mt-4 text-xl font-semibold text-accent-light">{why.lead}</p>
    </div>
    <div data-reveal class="max-w-2xl space-y-5 text-lg leading-relaxed text-muted-dark">
      {why.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <a
        href={why.cta.href}
        {...externalAttrs(why.cta, c.ui.newTab)}
        class="inline-flex min-h-12 items-center gap-2 rounded-full border border-white/25 bg-violet px-6 font-semibold text-white hover:bg-violet-deep"
      >
        <Icon name="whatsapp" class="size-5" />
        {why.cta.label}
      </a>
    </div>
  </div>
</Section>
