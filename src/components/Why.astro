---
import Section from './Section.astro';
import { sections, why } from '../data/site';

const { id, title } = sections.why;
---

<Section id={id} tone="light" labelledBy={`${id}-title`}>
  <div class="grid gap-10 md:grid-cols-[1fr_2fr] md:gap-16">
    <div>
      <h2 id={`${id}-title`} class="text-3xl font-bold tracking-tight md:text-4xl">{title}</h2>
      <p class="mt-4 text-xl font-semibold text-brand">{why.lead}</p>
    </div>
    <div class="max-w-2xl space-y-5 text-lg leading-relaxed text-muted">
      {why.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <p class="font-semibold text-ink">{why.closing}</p>
      <a
        href={why.cta.href}
        class="inline-flex min-h-11 items-center rounded-md bg-brand px-5 font-semibold text-white hover:bg-ink"
      >
        {why.cta.label}
      </a>
    </div>
  </div>
</Section>
