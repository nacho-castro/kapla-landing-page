---
import Icon from './Icon.astro';
import Section from './Section.astro';
import TodoContent from './TodoContent.astro';
import { contact, formspreeId, privacyUrl, sections, site } from '../data/site';

const { id, title } = sections.contact;
const inputClass =
  'mt-2 block w-full rounded-md border border-muted bg-white px-3 py-3 text-base text-ink placeholder:text-muted';
---

<Section id={id} tone="light" labelledBy={`${id}-title`}>
  <div class="grid gap-10 md:grid-cols-[1fr_1.4fr] md:gap-16">
    <div>
      <h2 id={`${id}-title`} class="text-3xl font-semibold tracking-tight md:text-4xl">{title}</h2>
      <p class="mt-4 text-lg text-muted">{contact.intro}</p>
      {
        site.whatsapp && (
          <a
            href={`https://wa.me/${site.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-brand underline underline-offset-4 hover:text-ink"
          >
            <Icon name="whatsapp" class="size-5" />
            {contact.whatsappLabel}
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        )
      }
    </div>

    {
      formspreeId ? (
        <form
          id="contact-form"
          action={`https://formspree.io/f/${formspreeId}`}
          method="POST"
          class="flex flex-col gap-5"
        >
          <div>
            <label for="contact-name" class="font-semibold">Nombre</label>
            <input id="contact-name" name="name" type="text" required maxlength="100" autocomplete="name" class={inputClass} />
          </div>
          <div>
            <label for="contact-email" class="font-semibold">Email</label>
            <input id="contact-email" name="email" type="email" required maxlength="200" autocomplete="email" class={inputClass} />
          </div>
          <div>
            <label for="contact-message" class="font-semibold">
              Mensaje <span class="font-normal text-muted">(opcional)</span>
            </label>
            <textarea id="contact-message" name="message" rows="4" maxlength="2000" class={inputClass} />
          </div>
          {/* Honeypot: hidden from people; bots fill it and Formspree discards the submission. */}
          <div class="hidden" aria-hidden="true">
            <label for="contact-gotcha">No completar</label>
            <input id="contact-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <p class="text-sm text-muted">
            {contact.privacyNote}{' '}
            <a href={privacyUrl} class="text-brand underline underline-offset-4 hover:text-ink">Aviso de privacidad</a>.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <button
              type="submit"
              data-sending={contact.sendingLabel}
              class="inline-flex min-h-12 items-center justify-center rounded-md bg-brand px-6 font-semibold text-white hover:bg-ink disabled:opacity-60"
            >
              {contact.submitLabel}
            </button>
            <p
              id="contact-status"
              role="status"
              class="text-sm font-semibold"
              data-success={contact.successMessage}
              data-error={contact.errorMessage}
            />
          </div>
        </form>
      ) : (
        <div>
          {/* TODO-CONTENIDO: set PUBLIC_FORMSPREE_ID (see .env.example). Until then only WhatsApp is shown. */}
          <TodoContent>identificador de Formspree (PUBLIC_FORMSPREE_ID) para mostrar el formulario.</TodoContent>
        </div>
      )
    }
  </div>
</Section>

<script>
  // Progressive enhancement: without JS the form posts to Formspree normally.
  const form = document.getElementById('contact-form');
  const status = document.getElementById('contact-status');

  if (form instanceof HTMLFormElement && status) {
    const button = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(button instanceof HTMLButtonElement)) return;

      const label = button.textContent ?? '';
      button.disabled = true;
      button.textContent = button.dataset['sending'] ?? label;
      status.textContent = '';

      let ok = false;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        ok = response.ok;
      } catch {
        ok = false;
      }

      // Fixed messages only (textContent): never echo user input or server details.
      status.textContent = (ok ? status.dataset['success'] : status.dataset['error']) ?? '';
      status.classList.toggle('text-brand', ok);
      button.textContent = label;
      if (ok) {
        form.reset();
        // Simple client-side cooldown; Formspree enforces the real limits.
        setTimeout(() => (button.disabled = false), 30_000);
      } else {
        button.disabled = false;
      }
    });
  }
</script>
