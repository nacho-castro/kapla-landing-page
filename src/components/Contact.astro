---
import Glow from './Glow.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import TodoContent from './TodoContent.astro';
import { contact, heroCtas, sections, site } from '../data/site';
import { externalAttrs } from '../utils/links';

const { id, title } = sections.contact;
const cta = { ...heroCtas.primary, label: contact.whatsappLabel };
---

<Section id={id} tone="dark" labelledBy={`${id}-title`} class="bg-linear-to-b from-navy to-ink">
  <Glow slot="background" variant="b" />
  <div data-reveal class="max-w-2xl">
    <h2 id={`${id}-title`} class="text-3xl font-semibold tracking-tight text-balance md:text-5xl">{title}</h2>
    <p class="mt-4 text-lg text-muted-dark">{contact.intro}</p>
    <a
      href={cta.href}
      {...externalAttrs(cta)}
      class="mt-8 inline-flex min-h-14 w-full items-center justify-center gap-2 rounded-full bg-whatsapp px-8 text-lg font-semibold text-ink hover:brightness-95 sm:w-auto"
    >
      <Icon name="whatsapp" class="size-6" />
      {cta.label}
    </a>
    <p class="mt-6">
      {
        site.email ? (
          <a
            href={`mailto:${site.email}`}
            class="inline-flex min-h-11 items-center text-accent-light underline underline-offset-4 hover:text-white"
          >
            {contact.emailLabel}: {site.email}
          </a>
        ) : (
          <TodoContent tone="dark">email de contacto.</TodoContent>
        )
      }
    </p>
  </div>
</Section>
